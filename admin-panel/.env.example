# API Configuration
# Points to the backend API endpoint for admin panel
VITE_API_BASE=http://localhost:5001/api/admin

# Backend URL for media/uploads (without /api path)
VITE_API_UPLOADS=http://localhost:5001

# TinyMCE Editor API Key
# Get your free API key at https://www.tiny.cloud/
VITE_TINYMCE_API_KEY=your-tinymce-api-key
