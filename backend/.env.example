# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/CMSDatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=CMSDatabase

# Security
JWT_SECRET=your-secret-key-change-in-production

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Email Configuration (optional - for contact form)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Seed Images Path (optional - defaults to public-site/public/images or backend/assets/seed-images)
# SEED_IMAGES_PATH=/path/to/seed/images
